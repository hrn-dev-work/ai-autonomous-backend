# Example environment keys (no secrets committed)

# Mock mode needs no LLM keys and no database by default.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DATABASE_URL=   # unused in this sample

# Optional public demo protection (when GENERATE_API_KEY is set, clients must send it).
# GENERATE_API_KEY=
# Authorization: Bearer <key>  OR  x-api-key: <key>

# Rate limit (in-memory, per process — defaults if unset)
# GENERATE_RATE_LIMIT_MAX=30
# GENERATE_RATE_LIMIT_WINDOW_MS=60000
