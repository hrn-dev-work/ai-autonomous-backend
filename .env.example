# Example environment keys (no secrets committed)

# Mock mode needs no LLM keys and no database by default.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DATABASE_URL=   # unused in this sample

# HTTP API protection (Server Action UI does not need this).
# Production (Vercel): set a long random GENERATE_API_KEY for curl/external callers.
# GENERATE_API_KEY=

# Rate limit
# GENERATE_RATE_LIMIT_MAX=30
# GENERATE_RATE_LIMIT_WINDOW_MS=60000

# Shared rate limit across serverless instances (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
