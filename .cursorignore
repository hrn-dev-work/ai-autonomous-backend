# Cursor indexing / AI context exclusions
# Keep secrets, dumps, and local artifacts out of the model context.

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credentials.json
**/secrets/**
**/private/**

# Logs
logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database dumps & bulk data imports (may contain PII)
dumps/
**/dumps/
*.sql
!prisma/migrations/**/*.sql
*.dump
*.backup
*.bak
*.csv
*.tsv
*.xlsx

# Local DB / Docker volumes (if ever mounted into workspace)
pgdata/
postgres-data/
.docker-data/

# Dependencies & build
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# Prisma local sqlite artifacts (if ever used)
prisma/*.db
prisma/*.db-journal

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Cursor local session markers
.cursor/retrospective/
